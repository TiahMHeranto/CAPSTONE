    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const data = $input.first().json;\nconst attendus = ['slack', 'email', 'webhook'];\nconst items = [];\nfor (const canal of data.canaux) {\n  if (!attendus.includes(canal)) continue;\n  let statut = 'envoye';\n  if (canal === 'slack' && !data.slack_url) statut = 'echec';\n  if (canal === 'email' && !data.email_url) statut = 'echec';\n  let voie = 'journal';\n  if (statut === 'envoye' && canal === 'slack') voie = 'slack';\n  if (statut === 'envoye' && canal === 'email') voie = 'email';\n  items.push({ json: { facture_id: data.facture_id, score: data.score, message: data.message, canal, statut, voie, tentative: 1, slack_url: data.slack_url, email_url: data.email_url } });\n}\nreturn items;"
      },
