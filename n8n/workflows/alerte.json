    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const source = $('Reception').first().json;\nconst entetes = source.headers || {};\nconst clef = entetes['x-alert-key'] || '';\nif (!clef || clef !== ($env.ADMIN_API_KEY || '')) return [];\nconst recu = source.body || source;\nconst reglages = $input.first().json;\nconst seuil = Number(reglages.alert_threshold);\nconst score = Number(recu.score);\nconst canaux = Array.isArray(reglages.notification_channels) ? reglages.notification_channels : [];\nconst assure = recu.assure_id || '';\nconst base = $env.APP_PUBLIC_URL || 'http://localhost:8000';\nconst lien = assure ? base + '/invoices/' + recu.facture_id + '?assure=' + assure : base + '/invoices/' + recu.facture_id;\nconst lignes = (recu.explications || []).slice(0, 5).map((item) => item.libelle + ' (' + item.contribution + ')');\nconst message = ['Alerte ' + recu.facture_id, 'Score ' + score + ' / seuil ' + seuil, 'Modele ' + (recu.model_version || ''), lignes.join(' | '), 'Lien ' + lien].join(' | ');\nreturn [{ json: { facture_id: recu.facture_id, score, seuil, model_version: recu.model_version || '', assure_id: assure, lien, message, canaux, sous_seuil: !(score >= seuil), slack_url: $env.SLACK_WEBHOOK_URL || '', email_url: $env.EMAIL_WEBHOOK_URL || '' } }];"
      },
