        {"nom": "statut", "type": "text", "description": "État du dossier.", "valeurs": ["PAYEE", "EN_COURS", "REJETEE"]},
        {"nom": "motif_rejet", "type": "text", "description": "Motif si la facture est rejetée."}
      ]
    },
