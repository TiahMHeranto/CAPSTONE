{
  "tables": [
    {
      "nom": "clean.dossier_factures",
      "description": "Factures visibles selon le jeton. L'assuré et le prestataire ne voient que leur compte. L'administrateur voit toutes les factures. Ne pas écrire un identifiant ASS-, PRE- ou CTR- sauf si le rôle est administrateur.",
      "colonnes": [
        {"nom": "facture_id", "type": "text", "description": "Identifiant de la facture."},
        {"nom": "assure_id", "type": "text", "description": "Pseudonyme de l'assuré. Déjà filtré pour un assuré."},
        {"nom": "prestataire_id", "type": "text", "description": "Établissement, à joindre à clean.prestataires."},
        {"nom": "ordonnance_id", "type": "text", "description": "Ordonnance liée, vide s'il n'y en a pas."},
        {"nom": "contrat_id", "type": "text", "description": "Contrat porté par la facture."},
        {
          "nom": "type_facture",
          "type": "text",
          "description": "Nature du soin.",
          "valeurs": ["CONSULTATION", "PHARMACIE", "LABORATOIRE", "IMAGERIE", "DENTAIRE", "KINESITHERAPIE", "MATERNITE", "OPTIQUE", "HOSPITALISATION"]
        },
        {"nom": "date_soin", "type": "date", "description": "Date du soin."},
        {"nom": "date_facture", "type": "date", "description": "Date de la facture."},
        {"nom": "montant_total", "type": "bigint", "description": "Montant total en ariary."},
