# Copier ce fichier vers .env. Remplacer chaque change-me avant un partage d'environnement.
# Le fichier .env ne doit pas être commité.

POSTGRES_USER=prediccare
POSTGRES_PASSWORD=change-me
POSTGRES_DB=prediccare

APP_DB_USER=prediccare_app
APP_DB_PASSWORD=change-me-app

AGENT_DB_USER=prediccare_agent
AGENT_DB_PASSWORD=change-me-agent

# Lecture seule des vues bi. Pas d'accès aux factures, aux labels ni aux identités.
BI_DB_USER=prediccare_bi
BI_DB_PASSWORD=change-me-bi

# URL lue par l'API (rôle applicatif, sans accès aux identités ni aux labels)
DATABASE_URL=postgresql+psycopg://prediccare_app:change-me-app@db:5432/prediccare
# URL lue par les migrations et le chargement initial (rôle propriétaire)
MIGRATE_DATABASE_URL=postgresql+psycopg://prediccare:change-me@db:5432/prediccare

# Valeur d'exemple du CDC. Le flux lit la ligne app.settings, pas cette constante dans le code.
ALERT_THRESHOLD=0.8
# Seuil PSI de la dérive des scores. Lu dans app.settings, pas dans le calcul du score.
DRIFT_PSI_THRESHOLD=0.25

# Publié sur toutes les interfaces : les machines du réseau local joignent l'API.
API_PORT=8000
# Assistant et lecture des factures. Clef créée dans Google AI Studio. Elle reste vide ici.
# gemma-4-31b-it est l'autre modèle Gemma 4 proposé par la même API.
# Les vecteurs font 768 dimensions : après un changement de modèle, relancer l'indexation.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_API_KEY=
LLM_MODEL=gemma-4-26b-a4b-it
LLM_EMBED_MODEL=gemini-embedding-001
LLM_EMBED_DIMENSIONS=768
# Chemin vu par l'API. Les PDF restent sur la machine, ils ne sont pas copiés dans l'image.
RAG_DIR=/corpus
# Dossier de l'hôte monté sur RAG_DIR au démarrage. Un autre chemin dans les réglages doit être visible dans le conteneur.
RAG_CORPUS_HOST=./CohorteAI_datagen/rag_corpus
RAG_INDEX_AU_DEMARRAGE=1
ASSISTANT_CACHE_SIMILARITE=0.92
LOG_LEVEL=INFO

DATASET_DIR=/data/dataset
LABELS_DIR=/data/labels

N8N_ENCRYPTION_KEY=change-me-n8n
N8N_PORT=5678
# Lecture d'un PDF de facture. Le workflow est n8n/workflows/ocr.json.
N8N_OCR_URL=http://n8n:5678/webhook/ocr
# Tableau de bord Superset. Le compte lit seulement le schéma bi.
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=change-me-superset
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=change-me-superset-admin
SUPERSET_ADMIN_EMAIL=admin@prediccare.local
# Lien placé dans le message d'alerte. Les canaux restent vides tant qu'ils ne sont pas branchés.
APP_PUBLIC_URL=http://localhost:8000
SLACK_WEBHOOK_URL=
EMAIL_WEBHOOK_URL=

# Clés hors de la base. Les remplacer avant tout partage d'environnement.
PSEUDO_HMAC_KEY=change-me-pseudo
PII_ENCRYPTION_KEY=change-me-pii
ADMIN_API_KEY=change-me-admin
AUTH_TOKEN_SECRET=change-me-auth
# Tentatives par fenêtre, par adresse. Zéro désactive la limite.
RATE_LIMIT_LOGIN=20
RATE_LIMIT_ADMIN=10
RATE_LIMIT_WINDOW_S=60
AGE_REFERENCE_YEAR=2026
RETENTION_IDENTITES_YEARS=5
